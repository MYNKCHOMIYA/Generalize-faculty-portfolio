# =============================================
# GENERALIZED FACULTY PORTFOLIO SYSTEM (GFPMS)
# Environment Variables - COPY THIS TO .env
# =============================================

# --- PostgreSQL Database ---
POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_SERVER=your_postgres_host  # e.g., db.render.com or localhost
POSTGRES_DB=gfpms_db

# --- Security ---
SECRET_KEY=your_super_secret_key_here_min_32_chars   # Generate: openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520  # 8 days

# --- Cloudinary (for file/image uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
